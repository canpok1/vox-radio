# e2e テスト用の複数VOICEVOXサーバー設定。
# default サーバーの接続先は環境変数 VOX_RADIO_VOICEVOX_URL、
# nemo サーバーの接続先は環境変数 VOX_RADIO_VOICEVOX_URL_NEMO（モックVOICEVOX NEMOのURL）で上書きされる。
llm:
  provider: openai
  temperature: 0.7
  max_retries: 1
  min_request_interval_ms: 0
  openai:
    base_url: {{LLM_URL}}
    api_key_env: TEST_LLM_API_KEY
    model: e2e-test-model

voicevox:
  engines:
    default:
      url: http://localhost:50021
    nemo:
      url: http://localhost:50121

cache:
  max_entries: 100
  retention_days: 90
  llm_context_entries: 10

slack:
  bot_token_env: TEST_SLACK_BOT_TOKEN

characters:
  zundamon:
    name: ずんだもん
    pronoun: ボク
    speech_suffix: ["〜のだ", "〜なのだ"]
    personality: ["元気", "明るい"]
    default_style: ノーマル
    styles:
      ノーマル: 3
  anneli:
    name: アンリ
    pronoun: わたし
    speech_suffix: ["〜だよ"]
    personality: ["クール"]
    default_style: ノーマル
    styles:
      ノーマル: 0
    engine: nemo
